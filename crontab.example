# User crontab example. Replace /absolute/path with your own paths.
# Initialize once before installing this entry:
# /usr/bin/python3 /absolute/path/aimaths/aim-cron.py --init --private-dir /absolute/path/aim-private --output-dir /absolute/path/aim-html
# Edit your crontab with: crontab -e
# Paste the environment settings and daily entry below into your existing crontab.
# Include the directory containing your Codex CLI in PATH, if necessary.
SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

# Run daily at 07:00 in the cron daemon's local timezone.
# Both directory parameters are required on every run.
# Capture stdout and stderr in a private log file; arrange rotation if needed.
0 7 * * * /usr/bin/python3 /absolute/path/aimaths/aim-cron.py --private-dir /absolute/path/aim-private --output-dir /absolute/path/aim-html >> /absolute/path/aim-private/cron.log 2>&1

# Optional X API coverage: append these flags before the log redirection above:
# --twitter-token-file /absolute/path/aim-private/twitter.token --twitter-monthly-budget 500 --twitter-max-posts 30
# Protect twitter.token with chmod 600 and set the account spending limit in X's console.
